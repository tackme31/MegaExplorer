{
  "manifestVersion": 1,
  "id": "com.example.sample.progress-cancel",
  "name": "Sample: Progress and cancel",
  "version": "0.1.0",
  "apiVersion": 1,
  "run": { "command": "uv", "args": ["run", "--quiet", "main.py"] },
  "commands": [
    { "id": "count", "title": "Count to 40 (with a total)", "progress": true },
    { "id": "spin", "title": "Work for 6 s (no total)", "progress": true },
    { "id": "quick", "title": "Finish at once (no dialog)", "progress": true },
    { "id": "stubborn", "title": "Ignore Cancel (Force quit)", "progress": true }
  ]
}
