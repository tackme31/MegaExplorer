{
  "manifestVersion": 1,
  "id": "com.example.tag-tools",
  "name": "Tag tools",
  "version": "0.1.0",
  "apiVersion": 1,
  "run": { "command": "uv", "args": ["run", "--quiet", "main.py"] },
