{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 21, "patch": 0 },
  "configurePresets": [
    {
      "name": "msvc-debug",
      "displayName": "MSVC 2022 x64 Debug (vcpkg)",
      "generator": "Visual Studio 17 2022",
      "architecture": {
        "value": "x64",
        "strategy": "set"
      },
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_PREFIX_PATH": "C:/Qt/6.11.1/msvc2022_64",
        "VCPKG_ROOT": "${sourceDir}/third_party/vcpkg",
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/third_party/vcpkg/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_MANIFEST_DIR": "${sourceDir}/third_party/sdk",
        "VCPKG_TARGET_TRIPLET": "x64-windows-mega",
        "VCPKG_OVERLAY_PORTS": "${sourceDir}/third_party/sdk/cmake/vcpkg_overlay_ports",
        "VCPKG_OVERLAY_TRIPLETS": "${sourceDir}/third_party/sdk/cmake/vcpkg_overlay_triplets",
        "VCPKG_MANIFEST_FEATURES": "use-openssl;use-freeimage;use-ffmpeg;use-pdfium;sdk-tests"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "msvc-debug",
      "configurePreset": "msvc-debug",
      "configuration": "Debug",
      "targets": ["appMegaExplorer", "megatool", "MegaExplorerTests", "MegaExplorerQmlTests"]
    }
  ],
  "testPresets": [
    {
      "name": "msvc-debug",
      "configurePreset": "msvc-debug",
      "configuration": "Debug",
      "output": { "outputOnFailure": true }
    }
  ]
}
